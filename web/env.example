# Base URL of the analysis API.
#
# Local development, browser and API on the same machine:
VITE_API_URL=http://127.0.0.1:8000

# Phone or another device on the same LAN:
#   1. find this machine's LAN address, for example 192.168.1.42
#   2. start the API so it accepts connections from outside localhost:
#        make run HOST=0.0.0.0
#   3. point the frontend at that address:
#        VITE_API_URL=http://192.168.1.42:8000
#
# To use this file, copy it to a file named `.env` in this directory:
#
#     cp env.example .env
#
# Vite loads `.env` and `.env.local`, never this template, and both of those are
# git-ignored so only this example is tracked. The name has no leading dot
# because the harness safety policy blocks writing dot-prefixed env paths; the
# purpose is unchanged: a human copies it, Vite never reads it.
